# 部署镜像标签。生产环境建议使用明确版本号，测试环境可使用 latest。
IMAGE_TAG=latest

# CloudMail 服务地址和管理员凭据，仅保存在 Broker 服务器。
CLOUDMAIL_BASE_URL=https://mail.example.com
CLOUDMAIL_ADMIN_EMAIL=admin@example.com
CLOUDMAIL_ADMIN_PASSWORD=replace-with-cloudmail-admin-password

# 管理接口密钥与各客户端独立密钥，请使用高强度随机值。
BROKER_ADMIN_KEY=replace-with-at-least-32-byte-random-admin-key
BROKER_CLIENT_KEYS_JSON={"image2api":"replace-with-image2api-client-key","windows-exe":"replace-with-windows-exe-client-key"}

# Token 缓存和上游请求设置。
TOKEN_CACHE_SECONDS=1500
TOKEN_REFRESH_SKEW_SECONDS=120
REQUEST_TIMEOUT_SECONDS=15
CLOUDMAIL_VERIFY_TLS=true
CLOUDMAIL_PROXY=

# 单 Client Key 每分钟限流。
TOKEN_RATE_LIMIT_PER_MINUTE=60
REFRESH_RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=2
LOG_LEVEL=INFO
