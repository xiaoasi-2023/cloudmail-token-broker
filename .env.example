# 阿里云自动构建镜像。生产环境建议使用明确版本号，测试环境可使用 latest。
IMAGE_NAME=registry.cn-hangzhou.aliyuncs.com/jiangshitong/cloudmail-token-broker:latest

# CloudMail 上游请求超时时间。实例地址、管理员凭据、代理和 TLS 由管理端维护。
REQUEST_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

# Xiaoasi Mail Gateway。生产环境只使用服务器 PostgreSQL，不创建数据库容器。
GATEWAY_ENABLED=true
DATABASE_URL=postgresql://gateway_user:replace-with-database-password@host.docker.internal:5432/xiaoasi_mail?connect_timeout=10

# 必须替换为两条不同的高强度随机字符串，至少 32 字节。
DATA_ENCRYPTION_KEY=replace-with-at-least-48-byte-data-encryption-key
MAILBOX_SESSION_SECRET=replace-with-at-least-48-byte-mailbox-session-secret
MAILBOX_SESSION_TTL_SECONDS=1800

# 管理端登录。生产环境建议配置 ADMIN_PASSWORD_HASH；也可先使用明文 ADMIN_PASSWORD。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=true
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10

# 邮箱业务接口按 X-API-Key 每分钟限流。
MAILBOX_CREATE_RATE_LIMIT_PER_MINUTE=120
MAILBOX_POLL_RATE_LIMIT_PER_MINUTE=600

USER_REGISTRATION_ENABLED=false

# POP3 uses the fixed public port 110; the container listens on 8110.
POP3_ENABLED=true
POP3_BIND_HOST=0.0.0.0
POP3_PORT=8110
