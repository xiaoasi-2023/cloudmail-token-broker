# 部署镜像标签。生产环境建议使用明确版本号，测试环境可使用 latest。
IMAGE_TAG=latest

# 旧 Token Broker 兼容配置。新网关不需要填写；仅在迁移旧客户端时配置。
CLOUDMAIL_BASE_URL=
CLOUDMAIL_ADMIN_EMAIL=
CLOUDMAIL_ADMIN_PASSWORD=

# 公开模式下，所有客户端都可以直接获取 Token，不需要 Authorization。
BROKER_PUBLIC_ACCESS=true

# 留空表示关闭管理接口。需要启用时填写至少 32 个字符的高强度随机密钥。
BROKER_ADMIN_KEY=

# Token 缓存和上游请求设置。
TOKEN_CACHE_SECONDS=1500
TOKEN_REFRESH_SKEW_SECONDS=120
REQUEST_TIMEOUT_SECONDS=15
CLOUDMAIL_VERIFY_TLS=true
CLOUDMAIL_PROXY=

# 公开模式下所有调用者共享同一组内存限流计数。
TOKEN_RATE_LIMIT_PER_MINUTE=600
REFRESH_RATE_LIMIT_PER_MINUTE=5
ADMIN_RATE_LIMIT_PER_MINUTE=2
LOG_LEVEL=INFO

# Xiaoasi Mail Gateway。开启后由管理端维护多个 CloudMail 实例和域名。
GATEWAY_ENABLED=true
GATEWAY_DATABASE_PATH=/app/data/xiaoasi-mail.db

# 必须替换为两条不同的高强度随机字符串，至少 32 字节。
DATA_ENCRYPTION_KEY=replace-with-at-least-48-byte-data-encryption-key
MAILBOX_SESSION_SECRET=replace-with-at-least-48-byte-mailbox-session-secret
MAILBOX_SESSION_TTL_SECONDS=1800

# 管理端登录。生产环境建议配置 ADMIN_PASSWORD_HASH；也可先使用明文 ADMIN_PASSWORD。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=true
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10

# 公开邮箱业务接口的每来源 IP 每分钟限流。
MAILBOX_CREATE_RATE_LIMIT_PER_MINUTE=120
MAILBOX_POLL_RATE_LIMIT_PER_MINUTE=600
